# OSAP Support — fichero de entorno (plantilla). Copiar a /etc/osap-support/env
# (o configurar el gestor de secretos del entorno). NUNCA versionar credenciales.

# --- Entorno / servidor ---
OSAP_SUPPORT_ENV=production
OSAP_SUPPORT_SERVER_HOST=127.0.0.1
OSAP_SUPPORT_SERVER_PORT=8300
# Orígenes CORS reales (solo si frontend y support son dominios distintos):
# OSAP_SUPPORT_CORS_ORIGINS=https://osap-app,https://www.openmusicrepository.com

# --- Base de datos (mismo usuario del ecosistema) ---
OSAP_SUPPORT_DB_HOST=127.0.0.1
OSAP_SUPPORT_DB_PORT=3306
OSAP_SUPPORT_DB_NAME=osap_support
OSAP_SUPPORT_DB_USER=osap2027
OSAP_SUPPORT_DB_PASSWORD=REEMPLAZAR

# --- Identidad (osap-auth, JWKS real) ---
OSAP_SUPPORT_AUTH_JWKS_URI=https://auth.openmusicrepository.com/auth/.well-known/jwks.json
OSAP_SUPPORT_AUTH_ISSUER=https://auth.openmusicrepository.com
OSAP_SUPPORT_AUTH_AUDIENCE=osap-support

# --- PayPal (sandbox/live) ---
OSAP_SUPPORT_PAYPAL_MODE=sandbox            # sandbox | live
OSAP_SUPPORT_PAYPAL_CLIENT_ID=REEMPLAZAR
OSAP_SUPPORT_PAYPAL_CLIENT_SECRET=REEMPLAZAR
OSAP_SUPPORT_PAYPAL_WEBHOOK_ID=REEMPLAZAR
# Plan IDs reales (creados una sola vez en el panel/sandbox; NO duplicarlos):
OSAP_SUPPORT_PAYPAL_PLAN_SUPPORTER_MONTHLY=P-MONTHLY-SUPPORTER
OSAP_SUPPORT_PAYPAL_PLAN_SUPPORTER_YEARLY=P-YEARLY-SUPPORTER
OSAP_SUPPORT_PAYPAL_PLAN_CONTRIBUTOR_MONTHLY=P-MONTHLY-CONTRIBUTOR
OSAP_SUPPORT_PAYPAL_PLAN_CONTRIBUTOR_YEARLY=P-YEARLY-CONTRIBUTOR
OSAP_SUPPORT_PAYPAL_PLAN_VOICE_MONTHLY=P-MONTHLY-VOICE
OSAP_SUPPORT_PAYPAL_PLAN_VOICE_YEARLY=P-YEARLY-VOICE
OSAP_SUPPORT_PAYPAL_PLAN_FOUNDER_MONTHLY=P-MONTHLY-FOUNDER
OSAP_SUPPORT_PAYPAL_PLAN_FOUNDER_YEARLY=P-YEARLY-FOUNDER

# --- Email (worker) ---
OSAP_SUPPORT_EMAIL_SENDER=smtp              # fake SOLO en dev/test
OSAP_SUPPORT_SMTP_HOST=smtp.example.com
OSAP_SUPPORT_SMTP_PORT=587
OSAP_SUPPORT_SMTP_USERNAME=REEMPLAZAR
OSAP_SUPPORT_SMTP_PASSWORD=REEMPLAZAR
OSAP_SUPPORT_SMTP_FROM=support@openmusicrepository.com
OSAP_SUPPORT_SMTP_TLS=1

# --- Worker ---
OSAP_SUPPORT_WORKER_POLL_SECONDS=30
