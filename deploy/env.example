# OSAP Support — fichero de entorno (plantilla). Copiar a /etc/osap-support/env
# (o configurar el gestor de secretos del entorno). NUNCA versionar credenciales.

# --- Entorno / servidor ---
OSAP_SUPPORT_ENV=production
OSAP_SUPPORT_SERVER_HOST=127.0.0.1
OSAP_SUPPORT_SERVER_PORT=8300
# Origen autorizado para handoff POST del panel admin desde osap-api.
OSAP_SUPPORT_SERVER_ADMIN_HANDOFF_ORIGINS=https://app.openmusicrepository.com
# Orígenes CORS reales (solo si frontend y support son dominios distintos):
# OSAP_SUPPORT_CORS_ORIGINS=https://osap-app,https://www.openmusicrepository.com

# --- Base de datos (mismo usuario del ecosistema) ---
OSAP_SUPPORT_DB_HOST=127.0.0.1
OSAP_SUPPORT_DB_PORT=3306
OSAP_SUPPORT_DB_NAME=osap_support
OSAP_SUPPORT_DB_USER=osap2027
OSAP_SUPPORT_DB_PASSWORD=

# --- Identidad (osap-auth, JWKS real) ---
OSAP_SUPPORT_AUTH_JWKS_URI=https://auth.openmusicrepository.com/auth-api/auth/.well-known/jwks.json
OSAP_SUPPORT_AUTH_ISSUER=https://auth.openmusicrepository.com
OSAP_SUPPORT_AUTH_AUDIENCE=osap-api
# Los service JWT M2M se emiten con aud=osap-support (distinto del user access token).
OSAP_SUPPORT_AUTH_SERVICE_AUDIENCE=osap-support

# --- PayPal (sandbox/live) ---
OSAP_SUPPORT_PAYPAL_MODE=live               # producción: exclusivamente live
OSAP_SUPPORT_PAYPAL_CLIENT_ID=
OSAP_SUPPORT_PAYPAL_CLIENT_SECRET=
OSAP_SUPPORT_PAYPAL_WEBHOOK_ID=
# Plan IDs reales (creados una sola vez en el panel Live; NO duplicarlos):
OSAP_SUPPORT_PAYPAL_PLAN_SUPPORTER_MONTHLY=
OSAP_SUPPORT_PAYPAL_PLAN_SUPPORTER_YEARLY=
OSAP_SUPPORT_PAYPAL_PLAN_CONTRIBUTOR_MONTHLY=
OSAP_SUPPORT_PAYPAL_PLAN_CONTRIBUTOR_YEARLY=
OSAP_SUPPORT_PAYPAL_PLAN_VOICE_MONTHLY=
OSAP_SUPPORT_PAYPAL_PLAN_VOICE_YEARLY=
OSAP_SUPPORT_PAYPAL_PLAN_FOUNDER_MONTHLY=
OSAP_SUPPORT_PAYPAL_PLAN_FOUNDER_YEARLY=

# --- Email (worker) ---
OSAP_SUPPORT_EMAIL_SENDER=smtp              # fake SOLO en dev/test
OSAP_SUPPORT_SMTP_HOST=
OSAP_SUPPORT_SMTP_PORT=587
OSAP_SUPPORT_SMTP_USERNAME=
OSAP_SUPPORT_SMTP_PASSWORD=
OSAP_SUPPORT_SMTP_FROM=support@openmusicrepository.com
OSAP_SUPPORT_SMTP_TLS=1

# --- Worker ---
OSAP_SUPPORT_WORKER_POLL_SECONDS=30
